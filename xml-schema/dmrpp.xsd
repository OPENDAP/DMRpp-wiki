<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:dmrpp="http://xml.opendap.org/dap/dmrpp/1.0.0#"
    targetNamespace="http://xml.opendap.org/dap/dmrpp/1.0.0#"
    elementFormDefault="qualified"
    attributeFormDefault="unqualified"
    version="1.0">

    <!-- ==========
         Simple types
         ========== -->

    <!-- Little / big endian byte order -->
    <xs:simpleType name="ByteOrder">
        <xs:restriction base="xs:string">
            <xs:enumeration value="LE" />
            <xs:enumeration value="BE" />
        </xs:restriction>
    </xs:simpleType>

    <!-- Unsigned 64-bit values (offsets, sizes) -->
    <xs:simpleType name="UnsignedLong">
        <xs:restriction base="xs:unsignedLong" />
    </xs:simpleType>

    <!-- Space-separated list of non-negative indices (for dims, chunk positions, etc.) -->
    <xs:simpleType name="IndexList">
        <xs:list itemType="xs:unsignedLong" />
    </xs:simpleType>

    <!-- Space-separated list of deflate levels -->
    <xs:simpleType name="DeflateLevelList">
        <xs:list itemType="xs:nonNegativeInteger" />
    </xs:simpleType>

    <!-- Space-separated list of struct field offsets -->
    <xs:simpleType name="StructOffsetList">
        <xs:list itemType="xs:nonNegativeInteger" />
    </xs:simpleType>

    <!-- How fixed-length strings are padded -->
    <xs:simpleType name="PadKind">
        <xs:restriction base="xs:string">
            <xs:enumeration value="null_pad" />
            <xs:enumeration value="null_term" />
            <xs:enumeration value="space_pad" />
            <xs:enumeration value="not_set" />
        </xs:restriction>
    </xs:simpleType>

    <!-- ==========
         Dataset-level attributes
         ========== -->

    <xs:attribute name="href" type="xs:anyURI">
        <xs:annotation>
            <xs:documentation>
                Location of the data for all data referenced by a 'chunk' or
                'block' unless those explicitly provide their own 'href'
                attribute. For example,
                "https://archive.podaac.earthdata.nasa.gov/podaac-ops-cumulus-protected/MUR-JPL-L4-GLOB-v4.1/20260519090000-JPL-L4_GHRSST-SSTfnd-MUR-GLOB-v02.0-fv04.1.nc"
            </xs:documentation>
        </xs:annotation>
    </xs:attribute>

    <xs:attribute name="trust" type="xs:boolean" default="false">
        <xs:annotation>
            <xs:documentation>
                If true, ...
            </xs:documentation>
        </xs:annotation>
    </xs:attribute>

    <xs:attribute name="version" type="xs:string">
        <xs:annotation>
            <xs:documentation>
                Version of the DMR++ software used to generate this DMR++. For
                example, "3.21.1-1090". 
            </xs:documentation>
        </xs:annotation>
    </xs:attribute>

    <xs:attribute name="s3" type="xs:anyURI">
        <xs:annotation>
            <xs:documentation>
                S3 URI for the data, e.g.,
                "s3://podaac-ops-cumulus-protected/MUR-JPL-L4-GLOB-v4.1/20260519090000-JPL-L4_GHRSST-SSTfnd-MUR-GLOB-v02.0-fv04.1.nc".
                If provided, this provides an alternative data source to the
                'href' attribute. 
            </xs:documentation>
        </xs:annotation>
    </xs:attribute>

    <xs:attribute name="s3credentials" type="xs:anyURI">
        <xs:annotation>
            <xs:documentation>
                URI for S3 credentials, e.g.,
                "https://archive.podaac.earthdata.nasa.gov/s3credentials". If
                provided, this provides the necessary credentials to access the
                S3 URI specified in the 's3' attribute. 
            </xs:documentation>
        </xs:annotation>
    </xs:attribute>

    <!-- To be used by the DMR Dataset element (dmrpp:href, dmrpp:trust, dmrpp:version, ...) 
         Note that this schema requires namespace qualified attributes because it defines
         information that is added to a DMR document. 
         Hyrax deviation: The DMZ parser in Hyrax requires these to _literally_ use 'dmrpp:...'.-->
    <xs:attributeGroup name="DatasetExtensionAttributes">
        <xs:attribute ref="dmrpp:href" use="required" />
        <xs:attribute ref="dmrpp:trust" use="optional" />
        <xs:attribute ref="dmrpp:version" use="optional" />
        <xs:attribute ref="dmrpp:s3" use="optional" />
        <xs:attribute ref="dmrpp:s3credentials" use="optional" />
    </xs:attributeGroup>

    <!-- ==========
         chunks / chunk / block
         ========== -->

    <xs:complexType name="ChunksType">
        <xs:sequence>
            <!-- Hyrax deviation: There may be one or more chunkDimensionSizes elements, but the
                 DMZ parser uses only the first. -->
            <!-- Typical element value looks like: 10 10 10 10 -->
            
            <xs:element ref="dmrpp:chunkDimensionSizes"
                minOccurs="0"
                maxOccurs="1" />
        
            <!-- Either chunks or blocks. Note that there can be zero chunks if the entire
                 array is fill values. The blocks element is used only for HDF4 data. -->

            <xs:choice minOccurs="0">
                <xs:element ref="dmrpp:chunk" minOccurs="1" maxOccurs="unbounded" />
                <xs:element ref="dmrpp:block" minOccurs="1" maxOccurs="unbounded" />
                <!-- linked-block mode branch, if still valid -->
            </xs:choice>
        </xs:sequence>

        <xs:attribute name="compressionType" type="xs:string" use="optional" >
            <xs:annotation>
                <xs:documentation>
                    Compression type, e.g., "shuffle deflate". If provided, this
                    applies to all chunks/blocks unless they explicitly provide
                    their own 'compressionType' attribute. Note that this
                    attribute lists the filters that were applied to the data in
                    the order they were applied. To decode the data, you would
                    apply the inverse filters in reverse order. For example, if
                    the value is "shuffle deflate", that means the data were
                    first shuffled and then deflated, so to decompress you would
                    first apply inflate and then unshuffle the data.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>

        <xs:attribute name="deflateLevel" type="dmrpp:DeflateLevelList" use="optional" >
            <xs:annotation>
                <xs:documentation>
                    Space-separated list of deflate levels for each deflate
                    filter in the 'compressionType' attribute. For example, if
                    'compressionType' is "shuffle deflate", and the deflate
                    level used was 5, then this attribute would be "5". If there
                    are multiple deflate filters, this would list the levels for
                    each of them in order. 
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>

        <xs:attribute name="fillValue" type="xs:string" use="optional" >
            <xs:annotation>
                <xs:documentation>
                    Fill value for the variable, if applicable. The string
                    interpreted according to the data type of the variable.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>

        <xs:attribute name="byteOrder" type="dmrpp:ByteOrder" use="optional" >
            <xs:annotation>
                <xs:documentation>
                    Byte order of the data. Valid values are "LE" for
                    little-endian and "BE" for big-endian. If not specified, the
                    default is "LE". 
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>

        <xs:attribute name="structOffset" type="dmrpp:StructOffsetList" use="optional" >
            <xs:annotation>
                <xs:documentation>
                    For structure variables, this attribute provides a
                    space-separated list of byte offsets for each field in the
                    structure. The order of offsets corresponds to the order of
                    fields in the structure definition. The first field has an
                    offset of 0 and so is not included in the list. The last
                    number in the list is the total size of the structure (this
                    is used for HDF COMPOUND types0). For example, if a
                    structure has three fields and the second field starts at
                    byte offset 4 and the third field starts at byte offset 12,
                    then this attribute would be "4 12 16" for a structure that
                    holds an int32, int64, float32 (4 bytes + 8 bytes + 4 bytes
                    = 16 bytes total). 
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>

        <xs:attribute name="LBChunk" type="xs:boolean" use="optional" >
            <xs:annotation>
                <xs:documentation>
                    For HDF4 data, this flag indicates whether the chunk is a
                    'linked block' chunk, which means it consists of multiple
                    blocks linked together. If true, then the 'LinkedBlockIndex'
                    attribute on each block indicates the index of that block in
                    the linked-block chain for this chunk.

                    FIXME!! jhrg 5/20/26
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>

        <!-- Direct I/O control; implementation looks for DIO="off" -->
        <xs:attribute name="DIO" type="xs:string" use="optional" >
            <xs:annotation>
                <xs:documentation>
                    Direct I/O control. If set to "off", this indicates that
                    direct I/O should not be used for this variable, even if the
                    server supports it. This is a hint that the server can use
                    to decide whether to use direct I/O or not when building
                    certain types of responses using this variable. If this si
                    not given, assume the value is false. 
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:complexType>

    <xs:complexType name="ChunkType">
        <xs:attribute name="offset" type="dmrpp:UnsignedLong" use="required" >
            <xs:annotation>
                <xs:documentation>
                    The byte offset of this chunk within the dataset.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute> 
        <xs:attribute name="nBytes" type="dmrpp:UnsignedLong" use="required" >
            <xs:annotation>
                <xs:documentation>
                    The size of this chunk in bytes.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <!-- Position of this chunk in chunk-space, e.g., "[0,0,0]" -->
        <!-- TODO Our DMZ parser may not enforce this as a required attribute jhrg 12/4/25 -->
        <xs:attribute name="chunkPositionInArray" type="dmrpp:IndexList" use="required" >
            <xs:annotation>
                <xs:documentation>
                    The position of this chunk in chunk-space, represented as a
                    comma-separated list of non-negative integers surrounded by
                    square brackets. The number of integers must match the
                    number of chunk dimensions specified in the
                    'chunkDimensionSizes' element. The value of each integer
                    indicates the index of this chunk along that dimension in
                    chunk-space. Chunk-space is a logical grid where each chunk
                    is indexed based on its position in the overall array, with
                    indices starting at 0. For example, for a 4D variable
                    chunked in 10x10x10x10 element blocks, the first chunk would
                    have "[0,0,0,0]", the second chunk along the first dimension
                    would have "[1,0,0,0]", and so on. 
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>

        <!-- Filter mask for per-chunk filters -->
        <xs:attribute name="fm" type="xs:unsignedInt" use="optional" >
            <xs:annotation>
                <xs:documentation>
                    Filter mask for per-chunk filters. This is a 32-bit bitmask
                    where each bit indicates whether a particular filter in the
                    'compressionType' attribute was applied to this chunk. In
                    some cases, filters failed when the data were written. This
                    mask can be used to determine which filters were actually
                    applied to this chunk. It is also used with the Direct I/O
                    optimization since the HDF5 chunk writer API requires this
                    information. 
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>

        <!-- Optional override of dataset-level href -->
        <xs:attribute name="href" type="xs:anyURI" use="optional" >
            <xs:annotation>
                <xs:documentation>
                    Optional override of dataset-level dmrpp:href attribute. If
                    provided, this is the location of the data for this chunk,
                    and it overrides any dataset-level 'href' attribute. This
                    allows different chunks to reference data in multiple files if needed.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>

        <xs:attribute name="trust" type="xs:boolean" use="optional" >
            <xs:annotation>
                <xs:documentation>
                    Optional override of dataset-level dmrpp:trust attribute.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>

        <!-- For multi-block chunks, index of this block in the linked-block chain -->
        <xs:attribute name="LinkedBlockIndex" type="xs:unsignedInt" use="optional" >
            <xs:annotation>
                <xs:documentation>
                    For HDF4 data, if this chunk is a linked block chunk
                    (indicated by the 'LBChunk' attribute), then this attribute
                    indicates the index of this block in the linked-block chain
                    for this chunk. The first block in the chain has index 0.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:complexType>

    <xs:complexType name="BlockType">
        <xs:attribute name="offset" type="dmrpp:UnsignedLong" use="required" />
        <xs:attribute name="nBytes" type="dmrpp:UnsignedLong" use="required" />
        <xs:attribute name="href" type="xs:anyURI" use="optional" />
        <xs:attribute name="trust" type="xs:boolean" use="optional" />
    </xs:complexType>

    <!-- ==========
         Fixed-length string array marker
         ========== -->

    <xs:complexType name="FixedLengthStringArrayType">
        <xs:attribute name="string_length" type="xs:positiveInteger" use="required" />
        <xs:attribute name="pad" type="dmrpp:PadKind" use="optional" default="not_set" />
    </xs:complexType>

    <!-- ==========
         Inline / compact data
         ========== -->

    <xs:simpleType name="CompactDataContents">
        <xs:restriction base="xs:base64Binary" />
    </xs:simpleType>

    <xs:complexType name="CompactType">
        <xs:simpleContent>
            <xs:extension base="dmrpp:CompactDataContents" />
        </xs:simpleContent>
    </xs:complexType>

    <!-- ==========
         Missing-data payload
         ========== -->

    <xs:complexType name="MissingDataType">
        <xs:simpleContent>
            <xs:extension base="xs:base64Binary" />
        </xs:simpleContent>
    </xs:complexType>

    <!-- ==========
         Special structure data payload
         ========== -->

    <xs:complexType name="SpecialStructureDataType">
        <xs:simpleContent>
            <xs:extension base="xs:base64Binary" />
        </xs:simpleContent>
    </xs:complexType>

    <!-- ==========
         Variable-length string array marker/payload
         Example usage:
            <vlsa>
                <v>string1</v>
                <v>string2</v>
                <v c="3">string3</v> # c attribute is RLL count for repeated value
            </vlsa>
         ========== -->

    <xs:complexType name="VLSASingleValueType">
        <xs:simpleContent>
            <xs:extension base="xs:string">
                <xs:attribute name="c" type="dmrpp:UnsignedLong" use="optional" />
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>

    <xs:complexType name="VlenStringArrayType">
        <xs:sequence>
            <xs:element name="v" type="dmrpp:VLSASingleValueType" minOccurs="0"
                maxOccurs="unbounded" />
        </xs:sequence>
    </xs:complexType>

    <!-- ==========
         Global element declarations
         ==========
         These are provided so the main DMR schema can import and reference them
         (e.g., via xs:any or explicit element refs).
         ========== -->

    <xs:element name="chunks" type="dmrpp:ChunksType">
        <xs:annotation>
            <xs:documentation>
                This element is in the DMR++ namespace and is normally written as 'dmrpp:chunks'.
                Hyrax deviation: the DMZ parser requires this element to literally use the
                'dmrpp:' prefix.
            </xs:documentation>
        </xs:annotation>
    </xs:element>
    <xs:element name="chunkDimensionSizes" type="dmrpp:IndexList">
        <xs:annotation>
            <xs:documentation>
                This element is in the DMR++ namespace and is normally written as
                'dmrpp:chunkDimensionSizes'. Hyrax deviation: the DMZ parser requires this
                element to literally use the 'dmrpp:' prefix.
                Sizes of the chunk dimensions, in order. For example, for a 4D variable
                chunked in 10x10x10x10 element blocks, this would be "10 10 10 10".
                However, for HDF5 'contiguous' data (i.e., data that are not chunked
                in the HDF5 sense but are stored in one contiguous region), this element
                is omitted. Similarly, for a 'chunk' that consists of only fill values,
                this element is also omitted.
            </xs:documentation>
        </xs:annotation>
    </xs:element>
    <xs:element name="chunk" type="dmrpp:ChunkType" />
    <xs:element name="block" type="dmrpp:BlockType" />

    <xs:element name="FixedLengthStringArray"
        type="dmrpp:FixedLengthStringArrayType" />

    <xs:element name="compact" type="dmrpp:CompactType" />
    <xs:element name="missingdata" type="dmrpp:MissingDataType" />
    <xs:element name="specialstructuredata"
        type="dmrpp:SpecialStructureDataType" />

    <xs:element name="vlsa"
        type="dmrpp:VlenStringArrayType" />

</xs:schema>
